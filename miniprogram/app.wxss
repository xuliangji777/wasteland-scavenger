/* 《墨土拾荒录》全局水墨玄暗基底样式 */
page {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background-color: #050709;
  color: #f2e6cf;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "PingFang SC", serif;
  overflow: hidden;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

view,
text,
image,
button,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
  background: transparent;
  color: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}
