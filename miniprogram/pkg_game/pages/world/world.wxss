.gear-slot-lbl { font-size: 16rpx; color: #e5bb5c; }
.gear-slot-name { font-size: 15rpx; max-width: 106rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gear-slot-empty { font-size: 18rpx; color: #8c8272; }

.dais-hero-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dais-hero-img {
  width: 180rpx;
  height: 230rpx;
}
.dais-stats {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 18rpx;
  color: #f3e4c3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.95);
}

.armory-list-pane {
  flex: 1.3;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.bag-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

/* 剧情区块 */
.act-block {
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(212, 162, 74, 0.24);
}
.act-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.step-line {
  display: flex;
  gap: 10rpx;
  padding: 4rpx 0;
  font-size: 19rpx;
  color: #d6cbb8;
}
.step-line.done {
  color: #6ee7b7;
}
.story-entry {
  padding: 10rpx 0;
  border-bottom: 1rpx dashed rgba(212, 162, 74, 0.2);
}

/* 结局卷轴 */
.ending-body {
  align-items: center;
  justify-content: center;
}
.ending-scroll {
  max-width: 72%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.96);
}
.ending-badge { font-size: 22rpx; color: #5eead4; letter-spacing: 4rpx; }
.ending-title { font-size: 44rpx; font-weight: 700; color: #fde68a; letter-spacing: 8rpx; }
.ending-content { font-size: 24rpx; line-height: 1.8; color: #f3ead8; }
