/* ==================== 《墨土拾荒录》v20 · 纯泼墨无框 1080P 横屏样式 ==================== */
page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #050709;
  color: #efe5d1;
  font-family: "Songti SC", "STSong", "PingFang SC", serif;
}

.rpg-root {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #050709;
}

.fx-shake {
  animation: inkShake 0.24s ease-out;
}
@keyframes inkShake {
  0%, 100% { transform: translate(0, 0); }
  25% { transform: translate(-6rpx, 3rpx); }
  50% { transform: translate(5rpx, -4rpx); }
  75% { transform: translate(-3rpx, 2rpx); }
}

/* 全屏 2.5D Canvas */
.world-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
}

/* 4x4 透明精灵图裁剪器（纯原生，零 CSS background-image 本地路径坑） */
.sprite-clip {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  border-radius: 14rpx;
}
.sprite-sheet-img {
  position: absolute;
  width: 400%;
  height: 400%;
  max-width: none;
  display: block;
}

/* 场景横幅 */
.scene-banner {
  position: fixed;
  top: 18%;
  left: 50%;
  transform: translate(-50%, -14rpx);
  z-index: 35;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease, transform 0.35s ease;
  text-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.95);
}
.scene-banner.show {
  opacity: 1;
  transform: translate(-50%, 0);
}
.scene-banner-region {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #e5bb5c;
}
.scene-banner-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  color: #f8efd8;
  margin-top: 4rpx;
}

/* Toast 浮空提示 */
.toast-wrap {
  position: fixed;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 90;
  pointer-events: none;
}
.toast-pill {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(16, 13, 10, 0.86) 0%, rgba(16, 13, 10, 0.45) 100%);
  border-bottom: 2rpx solid rgba(212, 162, 74, 0.65);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.9);
}
.toast-pill.toast-success { border-bottom-color: #6ee7b7; }
.toast-pill.toast-warn { border-bottom-color: #f87171; }
.toast-text {
  font-size: 22rpx;
  color: #f5ebd6;
  letter-spacing: 1rpx;
}

/* ==================== 顶部无框浮空 HUD ==================== */
.hud-top {
  position: fixed;
  top: 12rpx;
  left: max(20px, env(safe-area-inset-left));
  right: max(20px, env(safe-area-inset-right));
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  pointer-events: none;
}

.hud-left, .hud-right {
  pointer-events: auto;
}

.hud-hero-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hero-medallion {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(229, 187, 92, 0.85);
  box-shadow: 0 0 16rpx rgba(0, 0, 0, 0.85), 0 0 12rpx rgba(212, 162, 74, 0.35);
  overflow: visible;
}
.hero-portrait {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.hero-lv-seal {
  position: absolute;
  bottom: -6rpx;
  right: -8rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(145, 36, 26, 0.92);
  border: 1rpx solid #e5bb5c;
  font-size: 16rpx;
  color: #fdf2d6;
  font-weight: 700;
}

.hud-gauges {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.95);
}
.gauge-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.gauge-lbl {
  font-size: 18rpx;
  color: #e5bb5c;
  font-weight: 700;
}
.gauge-track {
  width: 160rpx;
  height: 10rpx;
  background: rgba(10, 8, 6, 0.58);
  transform: skewX(-18deg);
  overflow: hidden;
  border-bottom: 1rpx solid rgba(229, 187, 92, 0.35);
}
.gauge-fill {
  height: 100%;
  transition: width 0.25s ease;
}
.hp-fill {
  background: linear-gradient(90deg, #8b1e1a 0%, #d94638 65%, #f59e0b 100%);
}
.mp-fill {
  background: linear-gradient(90deg, #164e63 0%, #22d3ee 75%, #a5f3fc 100%);
}
.gauge-val {
  font-size: 17rpx;
  color: #f3e8d2;
}

.exp-hairline {
  width: 210rpx;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.14);
  margin: 2rpx 0;
}
.exp-hairline-fill {
  height: 100%;
  background: linear-gradient(90deg, #d4a24a, #fde68a);
}

.hud-telemetry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 18rpx;
  color: #d6cbb8;
}
.tele-num { color: #f6eedc; font-weight: 700; }
.tele-num.gold { color: #f5c869; }
.tele-num.food { color: #7ce8a4; }
.tele-dot { opacity: 0.45; }

.hud-quest-line {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 440rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.96);
}
.quest-seal {
  font-size: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: rgba(168, 42, 30, 0.85);
  color: #fde68a;
  flex-shrink: 0;
}
.quest-text {
  font-size: 18rpx;
  color: #efe5d1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hud-pills {
  margin-top: 6rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.pill-tag {
  font-size: 16rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.95);
  background: rgba(12, 10, 8, 0.42);
}
.pill-tag.guardian { color: #5eead4; }
.pill-tag.shield { color: #93c5fd; }
.pill-tag.warn { color: #fca5a5; }
.pill-tag.tide { color: #fde047; }

/* 右上地标与系统印 */
.hud-right {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.loc-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.96);
}
.loc-row-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.loc-map {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #f8efd8;
}
.loc-day {
  font-size: 18rpx;
  color: #e5bb5c;
}
.loc-row-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 18rpx;
  color: #d6cbb8;
}
.loc-ending { color: #c4b5fd; }

.hud-sys-btns {
  display: flex;
  gap: 10rpx;
}
.sys-glyph-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #f2d388;
  background: radial-gradient(circle, rgba(20, 16, 12, 0.58) 0%, rgba(20, 16, 12, 0.16) 100%);
  border: 1.5rpx solid rgba(212, 162, 74, 0.52);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.9);
}

/* ==================== 底部无框操控层 ==================== */
.hud-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 22;
  pointer-events: none;
}

/* 左下：王者荣耀人体工学挖孔屏安全区拇指大十字键 (v23) */
.dpad-safe-wrap {
  position: fixed;
  left: max(58px, calc(env(safe-area-inset-left) + 50px));
  bottom: max(18px, calc(env(safe-area-inset-bottom) + 14px));
  pointer-events: auto;
  opacity: 0.40;
  transition: opacity 0.16s ease;
}
.dpad-safe-wrap.active {
  opacity: 0.95;
}
.dpad-grid {
  width: 152px;
  height: 152px;
  display: grid;
  grid-template-columns: repeat(3, 48px);
  grid-template-rows: repeat(3, 48px);
  gap: 4px;
  align-items: center;
  justify-items: center;
}
.dpad-btn {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 700;
  color: #f6dc96;
  background: radial-gradient(circle, rgba(24, 19, 14, 0.84) 0%, rgba(24, 19, 14, 0.34) 100%);
  border: 1.5px solid rgba(229, 187, 92, 0.68);
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95);
}
.dpad-btn.pressed {
  background: radial-gradient(circle, rgba(212, 162, 74, 0.62) 0%, rgba(24, 19, 14, 0.48) 100%);
  border-color: #5eead4;
  transform: scale(0.94);
}
.dpad-core {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  color: rgba(229, 187, 92, 0.88);
  background: rgba(12, 10, 8, 0.42);
}

/* 底部居中：无框浮空书法功能坞（避开左侧大十字键与右侧交互键） */
.ink-dock {
  position: fixed;
  left: 52%;
  bottom: 14rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 14rpx;
  pointer-events: auto;
  padding: 6rpx 18rpx;
  background: radial-gradient(ellipse at center, rgba(10, 8, 6, 0.56) 0%, rgba(10, 8, 6, 0) 78%);
}
.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.96);
}
.dock-seal {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #efe5d1;
  background: radial-gradient(circle, rgba(28, 22, 16, 0.65) 0%, rgba(28, 22, 16, 0.12) 100%);
  border: 1.5rpx solid rgba(212, 162, 74, 0.48);
}
.dock-item.accent .dock-seal {
  border-color: #5eead4;
  color: #5eead4;
}
.dock-item.crucible .dock-seal {
  border-color: #e5bb5c;
  color: #fde68a;
  box-shadow: 0 0 14rpx rgba(229, 187, 92, 0.36);
}
.dock-lbl {
  font-size: 17rpx;
  color: #e2d5bd;
  letter-spacing: 1rpx;
}

/* 右下：无框水墨交互键 + 搜寻新迹 */
.action-cluster {
  position: fixed;
  right: max(22px, env(safe-area-inset-right));
  bottom: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  pointer-events: auto;
}
.ink-interact-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(22, 18, 14, 0.68) 0%, rgba(22, 18, 14, 0.22) 100%);
  border: 1.5rpx solid rgba(212, 162, 74, 0.48);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.95);
}
.ink-interact-btn.ready {
  border-color: #5eead4;
  background: radial-gradient(ellipse at center, rgba(20, 68, 62, 0.78) 0%, rgba(16, 28, 26, 0.32) 100%);
  box-shadow: 0 0 18rpx rgba(94, 234, 212, 0.35);
}
.interact-seal {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(168, 42, 30, 0.88);
  color: #fde68a;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.interact-text {
  font-size: 22rpx;
  color: #f8efd8;
  font-weight: 700;
}
.ink-refresh-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(14, 11, 8, 0.45);
  border: 1rpx solid rgba(212, 162, 74, 0.38);
}
.refresh-seal {
  font-size: 18rpx;
  color: #5eead4;
  font-weight: 700;
}
.refresh-text {
  font-size: 19rpx;
  color: #e5d8bf;
}

/* ==================== NPC 对话浮层 ==================== */
.dialog-overlay {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  padding: 20rpx max(36px, env(safe-area-inset-right)) 24rpx max(36px, env(safe-area-inset-left));
  background: linear-gradient(180deg, rgba(6, 5, 4, 0) 0%, rgba(8, 7, 6, 0.88) 38%, rgba(8, 7, 6, 0.96) 100%);
}
.dialog-strip {
  display: flex;
  align-items: flex-end;
  gap: 22rpx;
}
.dialog-portrait-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 2rpx solid #e5bb5c;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.9);
}
.dialog-portrait-img {
  width: 100%;
  height: 100%;
  display: block;
}
.dialog-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.dialog-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dialog-speaker-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.dialog-speaker {
  font-size: 28rpx;
  font-weight: 700;
  color: #f5c869;
}
.dialog-title {
  font-size: 19rpx;
  color: #b7aa94;
}
.dialog-close {
  font-size: 26rpx;
  color: #d4c6ae;
  padding: 6rpx 14rpx;
}
.dialog-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: #f3ead8;
}
.dialog-opts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}
.dialog-opt-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #efe5d1;
  background: rgba(28, 22, 16, 0.65);
  border: 1.5rpx solid rgba(212, 162, 74, 0.48);
}
.dialog-opt-btn.primary {
  border-color: #5eead4;
  color: #a7f3d0;
  background: rgba(18, 56, 52, 0.72);
}

/* ==================== 纯泼墨全屏 2.5D 回合战斗界 ==================== */
.battle-overlay {
  position: fixed;
  inset: 0;
  z-index: 60;
  overflow: hidden;
  background: #070606;
}
.battle-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.battle-vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 48%, rgba(0, 0, 0, 0.08) 28%, rgba(5, 4, 4, 0.72) 100%);
  pointer-events: none;
}

.bat-top {
  position: relative;
  z-index: 5;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx max(26px, env(safe-area-inset-right)) 0 max(26px, env(safe-area-inset-left));
}
.bat-side {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 38%;
}
.bat-side.hero-side {
  justify-content: flex-end;
}
.bat-crest {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(229, 187, 92, 0.85);
  background: radial-gradient(circle, rgba(24, 18, 14, 0.82), rgba(8, 6, 5, 0.4));
  overflow: hidden;
  flex-shrink: 0;
}
.bat-crest.enemy-crest {
  border-color: rgba(217, 70, 56, 0.85);
}
.bat-crest-img {
  width: 100%;
  height: 100%;
  display: block;
}
.bat-lv-tag {
  position: absolute;
  bottom: 0;
  right: 0;
  background: rgba(145, 36, 26, 0.9);
  color: #fde68a;
  font-size: 15rpx;
  padding: 1rpx 6rpx;
}
.bat-gauge-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.95);
}
.bat-gauge-col.right {
  align-items: flex-end;
}
.bat-name-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.bat-name-line.right {
  justify-content: flex-end;
}
.bat-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #f8efd8;
}
.bat-badge {
  font-size: 16rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  color: #5eead4;
  background: rgba(15, 58, 54, 0.72);
}
.bat-badge.boss {
  color: #fde68a;
  background: rgba(145, 32, 24, 0.82);
}
.bat-shield-tag {
  font-size: 17rpx;
  color: #93c5fd;
}
.bat-bar-track {
  width: 100%;
  max-width: 240rpx;
  height: 12rpx;
  background: rgba(10, 8, 6, 0.65);
  transform: skewX(-16deg);
  overflow: hidden;
  border-bottom: 1rpx solid rgba(229, 187, 92, 0.45);
}
.bat-bar-track.mp {
  height: 8rpx;
}
.bat-bar-fill {
  height: 100%;
  transition: width 0.25s ease;
}
.bat-bar-fill.enemy-hp { background: linear-gradient(90deg, #991b1b, #ef4444); }
.bat-bar-fill.hero-hp { background: linear-gradient(90deg, #b91c1c, #f59e0b); }
.bat-bar-fill.hero-mp { background: linear-gradient(90deg, #0e7490, #5eead4); }
.bat-meta-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.bat-hp-txt {
  font-size: 17rpx;
  color: #e6dac4;
}
.bat-status-tags {
  display: flex;
  gap: 6rpx;
}
.st-tag {
  font-size: 15rpx;
  padding: 1rpx 8rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.6);
}
.st-tag.burn { color: #fb923c; }
.st-tag.poison { color: #4ade80; }
.st-tag.def { color: #93c5fd; }
.st-tag.stun { color: #fde047; }

.bat-vs-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.vs-seal-oct {
  width: 62rpx;
  height: 62rpx;
  border-radius: 14rpx;
  transform: rotate(45deg);
  background: radial-gradient(circle, rgba(168, 42, 30, 0.92), rgba(78, 18, 14, 0.92));
  border: 2rpx solid #e5bb5c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fde68a;
  box-shadow: 0 0 18rpx rgba(212, 162, 74, 0.4);
}
.bat-turn-lbl {
  margin-top: 8rpx;
  font-size: 17rpx;
  color: #f3e4c3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.95);
}

/* 2.5D 错落战阵舞台 */
.bat-arena {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.bat-flash-banner {
  position: absolute;
  top: 24%;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 42rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0), rgba(14, 11, 8, 0.78) 25%, rgba(14, 11, 8, 0.78) 75%, rgba(0, 0, 0, 0));
  z-index: 12;
}
.bat-flash-txt {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #fde68a;
  text-shadow: 0 0 18rpx rgba(229, 187, 92, 0.85);
}

.fighter-slot {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.22s ease;
}
.enemy-slot {
  left: 20%;
  bottom: 24%;
}
.hero-slot {
  right: 26%;
  bottom: 26%;
}
.guardian-slot {
  right: 12%;
  bottom: 18%;
}
.fighter-sprite {
  display: block;
  z-index: 2;
}
.enemy-sprite {
  width: 240rpx;
  height: 240rpx;
  transform: scaleX(-1);
  transition: transform 0.65s ease, opacity 0.65s ease;
}
.enemy-sprite.sucking {
  transform: scaleX(-0.2) scaleY(0.2) translateY(-90rpx) rotate(360deg);
  opacity: 0.12;
}
.hero-sprite {
  width: 220rpx;
  height: 220rpx;
}
.guardian-sprite {
  width: 148rpx;
  height: 148rpx;
}
.guardian-plate {
  margin-top: 4rpx;
  font-size: 17rpx;
  color: #5eead4;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.95);
}
.fighter-shadow {
  width: 170rpx;
  height: 28rpx;
  margin-top: -16rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0) 74%);
}
.fighter-shadow.small {
  width: 110rpx;
  height: 20rpx;
}

.fighter-slot.lunge-right { transform: translateX(70rpx); }
.fighter-slot.lunge-left { transform: translateX(-70rpx); }
.fighter-slot.hit { animation: unitHit 0.28s ease; }
@keyframes unitHit {
  0%, 100% { transform: translateX(0); filter: brightness(1); }
  35% { transform: translateX(-18rpx); filter: brightness(1.8); }
  70% { transform: translateX(10rpx); }
}

.dmg-float {
  position: absolute;
  top: -28rpx;
  font-size: 36rpx;
  font-weight: 900;
  color: #fde68a;
  text-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.96);
  animation: dmgRise 0.85s ease-out forwards;
  z-index: 15;
}
.dmg-float.crit { color: #fb923c; font-size: 44rpx; }
.dmg-float.heal { color: #6ee7b7; }
.dmg-float.enemy-hit { color: #f87171; }
@keyframes dmgRise {
  0% { opacity: 0; transform: translateY(16rpx) scale(0.8); }
  25% { opacity: 1; transform: translateY(-8rpx) scale(1.1); }
  100% { opacity: 0; transform: translateY(-54rpx) scale(1); }
}

/* 纯泼墨天工墨壶收妖法阵 */
.capture-fx-layer {
  position: absolute;
  left: 16%;
  bottom: 20%;
  width: 300rpx;
  height: 360rpx;
  z-index: 14;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.capture-vessel-inverted {
  position: absolute;
  top: 0;
  width: 148rpx;
  height: 148rpx;
  transform: rotate(180deg);
  filter: drop-shadow(0 0 18rpx rgba(94, 234, 212, 0.72));
}
.capture-vortex {
  position: absolute;
  top: 96rpx;
  width: 210rpx;
  height: 210rpx;
  animation: spinSlow 1.4s linear infinite;
}
.capture-wheel-ground {
  position: absolute;
  bottom: -18rpx;
  width: 270rpx;
  height: 270rpx;
  transform: perspective(500rpx) rotateX(68deg);
  opacity: 0.88;
}
.capture-caption {
  position: absolute;
  top: -34rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #5eead4;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.96);
}
@keyframes spinSlow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

